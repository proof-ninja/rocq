static <A> A __() { return (A) __dummy; }

static <A1, A2, R>
R fix2(Function<Function<A1, Function<A2, R>>, Function<A1, Function<A2, R>>> gen, A1
a1, A2
a2) {
  return gen.apply(x1 -> x2 -> fix2(gen, x1, x2)).apply(a1).apply(a2);
}

