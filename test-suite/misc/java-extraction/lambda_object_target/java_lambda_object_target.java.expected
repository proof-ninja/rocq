static Function<nat, Function<nat, nat>> add;
static {
add = m -> n ->
((m instanceof nat.O) ? n
: (m instanceof nat.S) ? let(((nat.S)m).S0, m$ ->
                         ((nat) new nat.S(add.apply(m$).apply(n))))
: error("non-exhaustive match"))
;
