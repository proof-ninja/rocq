import java.util.function.Function;

class java_tail_dfix {

static <A, B> B let(A val, Function<A, B> cont) { return cont.apply(val); }

static <A> A error(String msg) { throw new RuntimeException(msg); }

static final Function<Object, Object> __dummy = new Function<Object, Object>() {
  public Object apply(Object x) { return this; }
};

@SuppressWarnings("unchecked")
static <A> A __() { return (A) __dummy; }

static abstract class $Step2<A1, A2, R> {}
static final class $Done2<A1, A2, R> extends $Step2<A1, A2, R> {
  final R value;
  $Done2(R value) { this.value = value; }
}
static final class $Next2<A1, A2, R> extends $Step2<A1, A2, R> {
  final A1 a1; final A2 a2;
  $Next2(A1 a1, A2 a2) { this.a1 = a1; this.a2 = a2; }
}
static <A1, A2, R> $Step2<A1, A2, R> $done2(R value) { return new $Done2<>(value); }
static <A1, A2, R> $Step2<A1, A2, R> $next2(A1 a1, A2 a2) { return new $Next2<>(a1, a2); }
static <A1, A2, R> R $run2(Function<A1, Function<A2, $Step2<A1, A2, R>>> body, A1 a1, A2 a2) {
  while (true) {
    $Step2<A1, A2, R> s = body.apply(a1).apply(a2);
    if (s instanceof $Next2<A1, A2, R> n) { a1 = n.a1; a2 = n.a2; }
    else return (($Done2<A1, A2, R>) s).value;
  }
}
static <A1, A2, R> Function<A1, Function<A2, R>> $loop2(Function<A1, Function<A2, $Step2<A1, A2, R>>> body) {
  return a1 -> a2 -> $run2(body, a1, a2);
}
static <A1, A2, R> R $tfix2(Function<Function<A1, Function<A2, R>>, Function<A1, Function<A2, $Step2<A1, A2, R>>>> gen, A1 a1, A2 a2) {
  return $run2(gen.apply(x1 -> x2 -> $tfix2(gen, x1, x2)), a1, a2);
}

static abstract class $Step3<A1, A2, A3, R> {}
static final class $Done3<A1, A2, A3, R> extends $Step3<A1, A2, A3, R> {
  final R value;
  $Done3(R value) { this.value = value; }
}
static final class $Next3<A1, A2, A3, R> extends $Step3<A1, A2, A3, R> {
  final A1 a1; final A2 a2; final A3 a3;
  $Next3(A1 a1, A2 a2, A3 a3) { this.a1 = a1; this.a2 = a2; this.a3 = a3; }
}
static <A1, A2, A3, R> $Step3<A1, A2, A3, R> $done3(R value) { return new $Done3<>(value); }
static <A1, A2, A3, R> $Step3<A1, A2, A3, R> $next3(A1 a1, A2 a2, A3 a3) { return new $Next3<>(a1, a2, a3); }
static <A1, A2, A3, R> R $run3(Function<A1, Function<A2, Function<A3, $Step3<A1, A2, A3, R>>>> body, A1 a1, A2 a2, A3 a3) {
  while (true) {
    $Step3<A1, A2, A3, R> s = body.apply(a1).apply(a2).apply(a3);
    if (s instanceof $Next3<A1, A2, A3, R> n) { a1 = n.a1; a2 = n.a2; a3 = n.a3; }
    else return (($Done3<A1, A2, A3, R>) s).value;
  }
}
static <A1, A2, A3, R> Function<A1, Function<A2, Function<A3, R>>> $loop3(Function<A1, Function<A2, Function<A3, $Step3<A1, A2, A3, R>>>> body) {
  return a1 -> a2 -> a3 -> $run3(body, a1, a2, a3);
}
static <A1, A2, A3, R> R $tfix3(Function<Function<A1, Function<A2, Function<A3, R>>>, Function<A1, Function<A2, Function<A3, $Step3<A1, A2, A3, R>>>>> gen, A1 a1, A2 a2, A3 a3) {
  return $run3(gen.apply(x1 -> x2 -> x3 -> $tfix3(gen, x1, x2, x3)), a1, a2, a3);
}

public interface nat {
public static class O implements nat {
  
  O() {
    }
    
  }

public static class S implements nat {
  final nat S0;
  
  S(nat S0) {
    this.S0 = S0;
    }
    
  }

}

public interface natlist {
public static class Nil implements natlist {
  
  Nil() {
    }
    
  }

public static class Cons implements natlist {
  final nat Cons0;
  final natlist Cons1;
  
  Cons(nat Cons0, natlist Cons1) {
    this.Cons0 = Cons0;
    this.Cons1 = Cons1;
    }
    
  }

}

static Function<natlist, Function<natlist, natlist>>
rev_append;
static {
rev_append = $loop2(l -> acc ->
((l instanceof natlist.Nil) ? $done2(acc)
: (l instanceof natlist.Cons) ? let(((natlist.Cons)l).Cons0, x ->
                                let(((natlist.Cons)l).Cons1, xs ->
                                $next2(xs, ((natlist)
                                new natlist.Cons(x, acc)))))
: error("non-exhaustive match"))
);
}

static Function<natlist, Function<nat, nat>>
length_acc;
static {
length_acc = $loop2(l -> n ->
((l instanceof natlist.Nil) ? $done2(n)
: (l instanceof natlist.Cons) ? let(((natlist.Cons)l).Cons1, xs ->
                                $next2(xs, ((nat) new nat.S(n))))
: error("non-exhaustive match"))
);
}

static Function<natlist, Function<nat, nat>>
mixed;
static {
mixed = $loop2(l -> acc ->
((l instanceof natlist.Nil) ? $done2(acc)
: (l instanceof natlist.Cons) ? let(((natlist.Cons)l).Cons0, n ->
                                let(((natlist.Cons)l).Cons1, xs ->
                                ((n instanceof nat.O) ? $next2(xs, ((nat)
                                   new nat.S(acc)))
                                : (n instanceof nat.S) ? $done2(((nat)
                                    new nat.S(mixed.apply(xs).apply(acc))))
                                : error("non-exhaustive match"))))
: error("non-exhaustive match"))
);
}

static Function<Function<nat, nat>, Function<natlist, Function<nat, nat>>>
iter;
static {
iter = $loop3(f -> l -> x ->
((l instanceof natlist.Nil) ? $done3(x)
: (l instanceof natlist.Cons) ? let(((natlist.Cons)l).Cons1, xs ->
                                $next3(y -> ((nat)
                                new nat.S(f.apply(y)))
                                , xs, f.apply(x)))
: error("non-exhaustive match"))
);
}

static Function<nat, Function<nat, nat>>
add_acc;
static {
add_acc = $loop2(n -> m ->
((n instanceof nat.O) ? $done2(m)
: (n instanceof nat.S) ? let(((nat.S)n).S0, p ->
                         $next2(p, ((nat) new nat.S(m))))
: error("non-exhaustive match"))
);
}

static Function<nat, Function<nat, nat>> add;
static {
add = n -> m ->
((n instanceof nat.O) ? m
: (n instanceof nat.S) ? let(((nat.S)n).S0, p ->
                         ((nat) new nat.S(add.apply(p).apply(m))))
: error("non-exhaustive match"))
;
}

}
