import java.util.function.Function;

class java_record {

static <A, B> B let(A val, Function<A, B> cont) { return cont.apply(val); }

static <A> A error(String msg) { throw new RuntimeException(msg); }

static final Function<Object, Object> __dummy = new Function<Object, Object>() {
  public Object apply(Object x) { return this; }
};

@SuppressWarnings("unchecked")
static <A> A __() { return (A) __dummy; }

public interface nat {}
public static class O implements nat {
  
  O() {
    }
    
  }

public static class S implements nat {
  final nat S0;
  
  S(nat S0) {
    this.S0 = S0;
    }
    
  }

public interface point {}
public static class MkPoint implements point {
  final nat MkPoint0;
  final nat MkPoint1;
  
  MkPoint(nat MkPoint0, nat MkPoint1) {
    this.MkPoint0 = MkPoint0;
    this.MkPoint1 = MkPoint1;
    }
    
  }

static point origin = ((point) new MkPoint(((nat) new O()), ((nat)
  new O())));

static Function<point, nat> getx = p ->
  ((p instanceof MkPoint) ? let(((MkPoint)p).MkPoint0, px -> px)
  : error("non-exhaustive match"))
  ;

static Function<point, nat> gety = p ->
  ((p instanceof MkPoint) ? let(((MkPoint)p).MkPoint1, py -> py)
  : error("non-exhaustive match"))
  ;

static Function<point, point> swap = p -> ((point)
  new MkPoint(((p instanceof MkPoint) ? let(((MkPoint)p).MkPoint1, py -> py)
  : error("non-exhaustive match")), ((p instanceof MkPoint) ? let(((MkPoint)p).MkPoint0, px ->
                                                              px)
  : error("non-exhaustive match"))))
  ;

static Function<point, point> bump = p -> ((point) new MkPoint(((nat)
  new S(((p instanceof MkPoint) ? let(((MkPoint)p).MkPoint0, px -> px)
  : error("non-exhaustive match")))), ((p instanceof MkPoint) ? let(((MkPoint)p).MkPoint1, py ->
                                                                py)
  : error("non-exhaustive match"))))
  ;

public interface tagged {}
public static class MkTagged implements tagged {
  final nat MkTagged0;
  final Function<nat, nat> MkTagged1;
  
  MkTagged(nat MkTagged0, Function<nat, nat> MkTagged1) {
    this.MkTagged0 = MkTagged0;
    this.MkTagged1 = MkTagged1;
    }
    
  }

static tagged mk_inc = ((tagged) new MkTagged(((nat) new O()), x -> ((nat)
  new S(x))
  ));

static Function<tagged, Function<nat, nat>> apply_tagged = t -> n ->
  ((t instanceof MkTagged) ? let(((MkTagged)t).MkTagged1, op -> op.apply(n))
  : error("non-exhaustive match"))
  ;

public interface bounded {}
public static class MkBounded implements bounded {
  final nat MkBounded0;
  final nat MkBounded1;
  
  MkBounded(nat MkBounded0, nat MkBounded1) {
    this.MkBounded0 = MkBounded0;
    this.MkBounded1 = MkBounded1;
    }
    
  }

static bounded mk_bounded = ((bounded) new MkBounded(((nat) new O()), ((nat)
  new S(((nat) new O())))));

static Function<bounded, nat> get_blo = b ->
  ((b instanceof MkBounded) ? let(((MkBounded)b).MkBounded0, blo -> blo)
  : error("non-exhaustive match"))
  ;

static Function<bounded, nat> get_bhi = b ->
  ((b instanceof MkBounded) ? let(((MkBounded)b).MkBounded1, bhi -> bhi)
  : error("non-exhaustive match"))
  ;

public interface pair {}
public static class MkPair implements pair {
  final Object MkPair0;
  final Object MkPair1;
  
  MkPair(Object MkPair0, Object MkPair1) {
    this.MkPair0 = MkPair0;
    this.MkPair1 = MkPair1;
    }
    
  }

static Function<nat, Function<nat, nat>> add;
static {
add = m -> n ->
((m instanceof O) ? n
: (m instanceof S) ? let(((S)m).S0, m$ ->
                     ((nat) new S(add.apply(m$).apply(n))))
: error("non-exhaustive match"))
;
}

static Function<nat, Function<nat, pair>> mk_nat_pair = x -> y -> ((pair)
  new MkPair(x, y))
  ;

static Function<pair, nat> pair_sum = p ->
  add.apply(((p instanceof MkPair) ? let(((MkPair)p).MkPair0, pfst ->
                                     ((nat) pfst))
     : error("non-exhaustive match"))).apply(((p instanceof MkPair) ? 
                                                let(((MkPair)p).MkPair1, psnd ->
                                                ((nat) psnd))
                                      : error("non-exhaustive match")))
  ;

public interface ppoint {}
public static class MkPPoint implements ppoint {
  final nat MkPPoint0;
  final nat MkPPoint1;
  
  MkPPoint(nat MkPPoint0, nat MkPPoint1) {
    this.MkPPoint0 = MkPPoint0;
    this.MkPPoint1 = MkPPoint1;
    }
    
  }

static Function<nat, Function<nat, ppoint>> mk_ppoint = x -> y -> ((ppoint)
  new MkPPoint(x, y))
  ;

static Function<ppoint, nat> get_ppx = p ->
  ((p instanceof MkPPoint) ? let(((MkPPoint)p).MkPPoint0, ppx -> ppx)
  : error("non-exhaustive match"))
  ;

static Function<ppoint, nat> get_ppy = p ->
  ((p instanceof MkPPoint) ? let(((MkPPoint)p).MkPPoint1, ppy -> ppy)
  : error("non-exhaustive match"))
  ;

}
