  new O())))
  ;

static nat
  p_var = ((nat) unbox2.apply(mk_var.apply(succ)).apply(((nat) new O())));

static nat
  p_app = ((nat) unbox2.apply(mk_app.apply(((nat) new S(((nat) new O())))))
                       .apply(((nat) new S(((nat) new O())))));

